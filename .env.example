# ==========================================
# QZH20 Environment Configuration Template
# ==========================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Found in your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER ONLY - NEVER expose to client)
# Used for administrative backend queries, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Secret key used to sign and verify session tokens (minimum 32 characters)
# Generate a secure key via: openssl rand -base64 32
SESSION_SECRET=your-secure-session-secret-key-at-least-32-characters-long
